{
  "private": true,
  "name": "proxy-switcher",
  "version": "4.1.0",
  "description": "Manifest V3 Chrome proxy switcher.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "node --test --test-timeout=10000 tests/*.test.js",
